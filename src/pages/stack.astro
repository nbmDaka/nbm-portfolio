---
import BaseLayout from '../layouts/BaseLayout.astro';

const categories = [
  {
    id: 'MOD_01',
    name: 'Backend Runtime',
    note: 'Services that hold under load.',
    state: 'CORE',
    tech: [
      { name: 'Go', context: 'High-throughput services and low-latency APIs' },
      { name: 'Java', context: 'Enterprise systems at national scale' },
      { name: 'Spring Boot', context: 'Production microservices, shipped fast' },
      { name: 'NestJS', context: 'Structured Node services with typed boundaries' },
    ],
  },
  {
    id: 'MOD_02',
    name: 'Infrastructure',
    note: 'Boring where it should be, sharp where it matters.',
    state: 'HARDENED',
    tech: [
      { name: 'Docker', context: 'Reproducible builds and deployments' },
      { name: 'Linux', context: 'Production servers, hardening, incident response' },
      { name: 'Nginx', context: 'Edge routing, TLS termination, load distribution' },
    ],
  },
  {
    id: 'MOD_03',
    name: 'Data Systems',
    note: 'The source of truth stays truthful.',
    state: 'OPTIMIZED',
    tech: [
      { name: 'PostgreSQL', context: 'Primary store — query optimization, high-load paths' },
      { name: 'MySQL', context: 'Service-owned schemas and legacy integration' },
      { name: 'Vector DB', context: 'Embedding storage and semantic retrieval' },
    ],
  },
  {
    id: 'MOD_04',
    name: 'AI Systems',
    note: 'Intelligence as infrastructure, not decoration.',
    state: 'ONLINE',
    ai: true,
    tech: [
      { name: 'RAG', context: 'Retrieval pipelines with measurable relevance' },
      { name: 'Embeddings', context: 'Semantic representations of unstructured data' },
      { name: 'AI APIs', context: 'Model integration under cost and latency budgets' },
    ],
  },
];

const principles = [
  'Boring technology on critical paths',
  'Sharp tools where they compound',
  'Every choice survives an incident review',
];
---

<BaseLayout title="Stack — Nurdaulet Beketov" description="The technology modules behind Nurdaulet Beketov's production systems: backend runtimes, infrastructure, data systems, and AI.">
  <section class="stack-page">
    <div class="stack-grid grid-field" aria-hidden="true"></div>
    <div class="page-shell stack-inner">
      <header class="stack-head">
        <p class="eyebrow">Stack / Runtime manifest</p>
        <h1>Tools with<br /><span>production scars.</span></h1>
        <div class="terminal-line" aria-hidden="true"><span>›</span> cat stack.yml <code>4 modules loaded</code></div>
      </header>

      <div class="module-list">
        {categories.map((category) => (
          <section class:list={['category', { ai: category.ai }]} aria-label={category.name}>
            <header>
              <div class="category-id">
                <span>{category.id}</span>
                <h2>{category.name}</h2>
              </div>
              <code><i></i>{category.state}</code>
            </header>
            <p class="category-note">{category.note}</p>
            <ul>
              {category.tech.map((item) => (
                <li>
                  <strong>{item.name}</strong>
                  <span>{item.context}</span>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>

      <footer class="stack-principles">
        <span>SELECTION CRITERIA</span>
        {principles.map((principle) => <p>{principle}</p>)}
      </footer>
    </div>
  </section>
</BaseLayout>

<style>
  .stack-page { position: relative; overflow: hidden; padding-top: 4.25rem; min-height: 100svh; }
  .stack-grid { position: absolute; inset: 4.25rem 0 auto; height: 42%; opacity: .55; }
  .stack-inner { position: relative; padding-top: clamp(4rem, 8vw, 7rem); padding-bottom: clamp(5rem, 9vw, 8rem); }

  .stack-head h1 { margin: 0; font: 510 clamp(3.2rem, 7vw, 6.8rem)/.9 'Geist Variable', sans-serif; letter-spacing: -.065em; }
  .stack-head h1 span { color: #71717a; }
  .terminal-line { display: flex; align-items: center; gap: .6rem; margin-top: 2.5rem; color: #71717a; font: 400 .7rem/1 'JetBrains Mono', monospace; }
  .terminal-line span { color: #00ff88; }
  .terminal-line code { margin-left: .5rem; border: 1px solid rgba(0,255,136,.18); border-radius: 99px; padding: .4rem .6rem; color: #00ff88; font: 500 .52rem/1 'JetBrains Mono', monospace; letter-spacing: .07em; }

  .module-list { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; margin-top: clamp(4rem, 7vw, 6rem); border: 1px solid var(--line); background: var(--line); }
  .category { display: flex; flex-direction: column; background: #050505; padding: clamp(1.5rem, 3vw, 2.5rem); transition: background 200ms ease; }
  .category:hover { background: #080809; }
  .category header { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; }
  .category-id span { color: #52525b; font: 500 .56rem/1 'JetBrains Mono', monospace; letter-spacing: .1em; }
  .category-id h2 { margin: .8rem 0 0; font: 520 clamp(1.6rem, 2.6vw, 2.4rem)/1 'Geist Variable', sans-serif; letter-spacing: -.04em; }
  .category header code { display: flex; align-items: center; gap: .45rem; border: 1px solid rgba(0,255,136,.16); border-radius: 99px; padding: .42rem .6rem; color: #00ff88; font: 500 .5rem/1 'JetBrains Mono', monospace; letter-spacing: .08em; }
  .category header i { width: .3rem; height: .3rem; border-radius: 50%; background: #00ff88; }
  .category.ai header code { border-color: rgba(99,102,241,.3); color: #818cf8; }
  .category.ai header i { background: #6366f1; box-shadow: 0 0 10px rgba(99,102,241,.7); }
  .category-note { margin: 1rem 0 0; color: #71717a; font-size: .82rem; line-height: 1.6; }
  .category ul { display: flex; flex-direction: column; margin: 2.2rem 0 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }
  .category li { display: grid; grid-template-columns: minmax(7rem, .42fr) 1fr; gap: 1rem; align-items: baseline; padding: .85rem 0; border-bottom: 1px solid var(--line); }
  .category li:last-child { border-bottom: 0; }
  .category li strong { color: #e4e4e7; font: 500 .78rem/1.3 'JetBrains Mono', monospace; }
  .category.ai li strong { color: #c7cbfb; }
  .category li span { color: #52525b; font-size: .7rem; line-height: 1.5; }

  .stack-principles { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: clamp(4rem, 7vw, 6rem); padding-top: 1.4rem; border-top: 1px solid var(--line); }
  .stack-principles span { grid-column: 1 / -1; color: #52525b; font: 500 .56rem/1 'JetBrains Mono', monospace; letter-spacing: .12em; }
  .stack-principles p { margin: 0; color: #71717a; font: 400 .72rem/1.5 'JetBrains Mono', monospace; }
  .stack-principles p::before { content: '› '; color: #00ff88; }

  @media (max-width: 820px) {
    .module-list { grid-template-columns: 1fr; }
    .stack-principles { grid-template-columns: 1fr; gap: .7rem; }
    .category li { grid-template-columns: 1fr; gap: .35rem; }
  }
</style>
