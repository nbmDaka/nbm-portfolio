---
import '../styles/global.css';
import SiteNav from '../components/SiteNav.astro';
import CommandPalette from '../components/react/CommandPalette';
import { useTranslations, localePrefix } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
}

const locale = Astro.currentLocale ?? 'en';
const t = useTranslations(locale);
const home = localePrefix(locale);

const {
  title = t.meta.title,
  description = t.meta.description,
} = Astro.props;

const site = Astro.site ?? new URL('https://nurdaulet.dev');
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL('/og.png', site).href;

const paletteCommands = t.palette.commands.map((command) => ({
  ...command,
  href: command.href.startsWith('#') ? `${home}/${command.href}` : command.href.startsWith('/') && command.href !== '/stack' ? command.href : command.href === '/stack' ? `${home}/stack` : command.href,
}));
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#050505" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={locale === 'ru' ? 'ru_RU' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" hreflang="en" href={new URL(Astro.url.pathname.replace(/^\/ru(?=\/|$)/, '') || '/', site).href} />
    <link rel="alternate" hreflang="ru" href={new URL(`/ru${Astro.url.pathname.replace(/^\/ru(?=\/|$)/, '') || '/'}`, site).href} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">{t.common.skip}</a>
    <SiteNav />
    <main id="main"><slot /></main>
    <CommandPalette client:idle commands={paletteCommands} placeholder={t.palette.placeholder} label={t.palette.label} empty={t.palette.empty} />
    <style>
      .skip-link {
        position: fixed;
        z-index: 100;
        top: 0.75rem;
        left: 0.75rem;
        translate: 0 -200%;
        border-radius: 0.25rem;
        background: #00ff88;
        padding: 0.75rem 1rem;
        color: #050505;
        font: 600 0.75rem/1 'JetBrains Mono', monospace;
      }
      .skip-link:focus { translate: 0; }
    </style>
  </body>
</html>
