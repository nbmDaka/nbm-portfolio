---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations } from '../i18n/ui';

const t = useTranslations(Astro.currentLocale);
const s = t.stack;

const moduleCount = s.groups.reduce((sum, group) => sum + group.tech.length, 0);
---

<BaseLayout title={t.meta.stackTitle} description={t.meta.stackDescription}>
  <section class="stack-page">
    <div class="stack-grid grid-field" aria-hidden="true"></div>
    <div class="page-shell stack-inner">
      <header class="stack-head">
        <p class="eyebrow">{s.eyebrow}</p>
        <h1>{s.titleA}<br /><span>{s.titleB}</span></h1>
        <div class="terminal-line" aria-hidden="true"><span>›</span> {s.cmd} <code>{moduleCount} {s.loaded}</code></div>
      </header>

      {s.groups.map((group) => (
        <div class="tier">
          <header class="tier-head">
            <h2><i class:list={[{ ai: group.ai }]}></i>{group.id}</h2>
            <p>{group.note}</p>
          </header>
          <div class:list={['group-card', { ai: group.ai }]}>
            <ul>
              {group.tech.map((item) => (
                <li>
                  <strong>{item.name}</strong>
                  <span><b>{s.usedFor}</b>{item.context}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}

      <footer class="stack-principles">
        <span>{s.criteria}</span>
        {s.principles.map((principle) => <p>{principle}</p>)}
      </footer>
    </div>
  </section>
</BaseLayout>

<style>
  .stack-page { position: relative; overflow: hidden; padding-top: 4.25rem; min-height: 100svh; }
  .stack-grid { position: absolute; inset: 4.25rem 0 auto; height: 42%; opacity: .55; }
  .stack-inner { position: relative; padding-top: clamp(4rem, 8vw, 7rem); padding-bottom: clamp(5rem, 9vw, 8rem); }

  .stack-head h1 { margin: 0; font: 510 clamp(3.2rem, 7vw, 6.8rem)/.9 'Geist Variable', sans-serif; letter-spacing: -.065em; }
  .stack-head h1 span { color: #71717a; }
  .terminal-line { display: flex; align-items: center; gap: .6rem; margin-top: 2.5rem; color: #71717a; font: 400 .7rem/1 'JetBrains Mono', monospace; }
  .terminal-line span { color: #00ff88; }
  .terminal-line code { margin-left: .5rem; border: 1px solid rgba(0,255,136,.18); border-radius: 99px; padding: .4rem .6rem; color: #00ff88; font: 500 .52rem/1 'JetBrains Mono', monospace; letter-spacing: .07em; }

  .tier { margin-top: clamp(3.5rem, 6vw, 5rem); }
  .tier-head { display: flex; align-items: baseline; justify-content: space-between; gap: 2rem; padding-bottom: 1.4rem; border-bottom: 1px solid var(--line-strong); }
  .tier-head h2 { display: flex; align-items: center; gap: .7rem; margin: 0; font: 500 .78rem/1 'JetBrains Mono', monospace; letter-spacing: .14em; }
  .tier-head h2 i { width: .45rem; height: .45rem; border-radius: 50%; background: #00ff88; box-shadow: 0 0 12px rgba(0,255,136,.55); }
  .tier-head h2 i.ai { background: #6366f1; box-shadow: 0 0 12px rgba(99,102,241,.6); }
  .tier:last-of-type .tier-head h2 i { background: #71717a; box-shadow: none; }
  .tier-head p { margin: 0; color: #52525b; font-size: .76rem; }

  .group-card { border: 1px solid var(--line); background: #050505; padding: 0 clamp(1.5rem, 3vw, 2.5rem); }
  .group-card ul { display: grid; grid-template-columns: 1fr 1fr; column-gap: 3rem; margin: 0; padding: 0; list-style: none; }
  .group-card li { display: grid; grid-template-columns: minmax(7rem, .42fr) 1fr; gap: 1rem; align-items: baseline; padding: 1rem 0; border-bottom: 1px solid var(--line); }
  .group-card li:last-child, .group-card li:nth-last-child(2):nth-child(odd) { border-bottom: 0; }
  .group-card li strong { color: #e4e4e7; font: 500 .78rem/1.3 'JetBrains Mono', monospace; }
  .group-card.ai li strong { color: #c7cbfb; }
  .group-card li span { color: #71717a; font-size: .74rem; line-height: 1.55; }
  .group-card li span b { display: block; margin-bottom: .3rem; color: #3f3f46; font: 500 .5rem/1 'JetBrains Mono', monospace; letter-spacing: .1em; text-transform: uppercase; }

  .stack-principles { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: clamp(4rem, 7vw, 6rem); padding-top: 1.4rem; border-top: 1px solid var(--line); }
  .stack-principles span { grid-column: 1 / -1; color: #52525b; font: 500 .56rem/1 'JetBrains Mono', monospace; letter-spacing: .12em; }
  .stack-principles p { margin: 0; color: #71717a; font: 400 .72rem/1.5 'JetBrains Mono', monospace; }
  .stack-principles p::before { content: '› '; color: #00ff88; }

  @media (max-width: 820px) {
    .group-card ul { grid-template-columns: 1fr; }
    .group-card li:nth-last-child(2):nth-child(odd) { border-bottom: 1px solid var(--line); }
    .tier-head { display: block; }
    .tier-head p { margin-top: .6rem; }
    .stack-principles { grid-template-columns: 1fr; gap: .7rem; }
    .group-card li { grid-template-columns: 1fr; gap: .35rem; }
  }
</style>
