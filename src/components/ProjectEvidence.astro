---
import { useTranslations } from '../i18n/ui';

const t = useTranslations(Astro.currentLocale).evidence;
---

<section class="section-shell evidence" id="evidence" aria-labelledby="evidence-title">
  <div class="evidence-head">
    <div>
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 class="section-title" id="evidence-title">{t.title}</h2>
    </div>
    <p class="section-copy">{t.copy}</p>
  </div>
  <div class="evidence-grid">
    {[t.oss, t.private].map((card) => (
      <article class="evidence-card">
        <header><span class:list={[card.label.toLowerCase().replace(' ', '-')]}>{card.label}</span></header>
        <h3>{card.title}</h3>
        <p>{card.text}</p>
        <a href={card.href} target={card.href.startsWith('http') ? '_blank' : undefined} rel="noreferrer">
          {card.cta} <b>↗</b>
        </a>
      </article>
    ))}
  </div>
</section>

<style>
  .evidence-head { display: grid; grid-template-columns: 1.1fr .9fr; gap: 5vw; align-items: end; }
  .evidence-head .section-copy { justify-self: end; }
  .evidence-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; margin-top: clamp(3.5rem, 6vw, 5rem); border: 1px solid var(--line); background: var(--line); }
  .evidence-card { display: flex; min-height: 17rem; flex-direction: column; background: #050505; padding: clamp(1.5rem, 3vw, 2.25rem); transition: background 200ms ease; }
  .evidence-card:hover { background: #080809; }
  .evidence-card header span { border: 1px solid var(--line-strong); border-radius: 99px; padding: .4rem .6rem; color: #a1a1aa; font: 500 .52rem/1 'JetBrains Mono', monospace; letter-spacing: .1em; }
  .evidence-card header span.open-source { border-color: rgba(0,255,136,.25); color: #00ff88; }
  .evidence-card h3 { margin: 1.5rem 0 0; font: 520 clamp(1.4rem, 2.4vw, 2rem)/1.1 'Geist Variable', sans-serif; letter-spacing: -.035em; }
  .evidence-card p { max-width: 420px; margin: .9rem 0 0; color: #71717a; font-size: .85rem; line-height: 1.65; }
  .evidence-card a { display: inline-flex; width: max-content; align-items: center; gap: .8rem; margin-top: auto; padding-top: 1.5rem; color: #fff; font: 500 .68rem/1 'JetBrains Mono', monospace; letter-spacing: .06em; text-decoration: none; }
  .evidence-card a b { color: #00ff88; font-weight: 400; transition: transform 180ms ease; }
  .evidence-card a:hover b { transform: translate(2px, -2px); }
  @media (max-width: 780px) { .evidence-head { grid-template-columns: 1fr; } .evidence-head .section-copy { justify-self: start; } .evidence-grid { grid-template-columns: 1fr; } }
</style>
