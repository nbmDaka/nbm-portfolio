---
const metrics = [
  { value: '3.5M+', label: 'users served', detail: 'National testing platform — registration through exam delivery', tone: 'green' },
  { value: '40K–50K', label: 'peak concurrent users', detail: 'Held through exam windows without losing submissions', tone: 'green' },
  { value: 'AI', label: 'RAG & vector search', detail: 'Retrieval pipelines and semantic job matching in production', tone: 'indigo' },
  { value: 'PROD', label: 'large-scale systems', detail: 'Deployments, Linux infrastructure, and incident response', tone: 'white' },
];
---

<section class="impact" id="impact" aria-labelledby="impact-title">
  <div class="impact-inner page-shell">
    <div class="impact-head">
      <p class="eyebrow">Impact / Production record</p>
      <h2 id="impact-title" class="sr-only">Career impact in production</h2>
      <p class="impact-note">Scale this engineer has personally built and operated. Numbers from production systems, not side projects.</p>
    </div>
    <div class="impact-grid">
      {metrics.map((metric) => (
        <div class:list={['metric', metric.tone]}>
          <strong>{metric.value}</strong>
          <span>{metric.label}</span>
          <p>{metric.detail}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .impact { border-top: 1px solid var(--line); }
  .impact-inner { padding-top: clamp(3.5rem, 7vw, 6rem); padding-bottom: clamp(3.5rem, 7vw, 6rem); }
  .impact-head { display: flex; align-items: end; justify-content: space-between; gap: 2rem; }
  .impact-head .eyebrow { margin-bottom: 0; }
  .impact-note { max-width: 380px; margin: 0; color: #71717a; font-size: .8rem; line-height: 1.6; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .impact-grid { display: grid; grid-template-columns: repeat(4, 1fr); margin-top: 3.5rem; border-top: 1px solid var(--line-strong); border-left: 1px solid var(--line); }
  .metric { min-height: 16rem; display: flex; flex-direction: column; padding: 1.5rem; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); background: var(--surface); transition: background 200ms ease; }
  .metric:hover { background: rgba(255,255,255,.045); }
  .metric strong { font: 500 clamp(2.9rem, 4.6vw, 5rem)/1 'Geist Variable', sans-serif; letter-spacing: -.045em; }
  .metric.green strong { color: #00ff88; }
  .metric.indigo strong { color: #818cf8; }
  .metric.white strong { color: #fff; }
  .metric span { margin-top: .8rem; color: #e4e4e7; font: 500 .72rem/1.4 'JetBrains Mono', monospace; letter-spacing: .06em; text-transform: uppercase; }
  .metric p { margin: auto 0 0; padding-top: 1.5rem; color: #71717a; font-size: .78rem; line-height: 1.55; }
  @media (max-width: 980px) { .impact-grid { grid-template-columns: 1fr 1fr; } .metric { min-height: 13rem; } }
  @media (max-width: 640px) { .impact-head { display: block; } .impact-note { margin-top: 1.2rem; } .impact-grid { grid-template-columns: 1fr; } .metric { min-height: 11rem; } }
</style>
