---
import { useTranslations } from '../i18n/ui';

const t = useTranslations(Astro.currentLocale).notes;
---

<section class="section-shell notes" id="notes" aria-labelledby="notes-title">
  <div class="notes-head">
    <div>
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 class="section-title" id="notes-title">{t.title}</h2>
    </div>
    <p class="section-copy">{t.copy}</p>
  </div>
  <div class="note-list">
    {t.items.map((item, index) => (
      <article>
        <span class="note-index">{String(index + 1).padStart(2, '0')}</span>
        <div class="note-main">
          <h3>{item.title}</h3>
          <p>{item.topic}</p>
        </div>
        <span class="note-state">{t.plannedLabel}</span>
      </article>
    ))}
  </div>
</section>

<style>
  .notes-head { display: grid; grid-template-columns: 1.1fr .9fr; gap: 5vw; align-items: end; }
  .notes-head .section-copy { justify-self: end; }
  .note-list { margin-top: clamp(3.5rem, 6vw, 5rem); border-top: 1px solid var(--line-strong); }
  article { display: grid; grid-template-columns: 3rem 1fr auto; gap: clamp(1rem, 3vw, 3rem); align-items: center; min-height: 5.5rem; border-bottom: 1px solid var(--line); }
  .note-index { color: #3f3f46; font: 400 .62rem/1 'JetBrains Mono', monospace; }
  .note-main h3 { margin: 0; font: 500 clamp(1.05rem, 1.8vw, 1.4rem)/1.25 'Geist Variable', sans-serif; letter-spacing: -.02em; }
  .note-main p { margin: .45rem 0 0; color: #52525b; font: 400 .62rem/1.4 'JetBrains Mono', monospace; }
  .note-state { border: 1px dashed var(--line-strong); border-radius: 99px; padding: .42rem .6rem; color: #52525b; font: 500 .5rem/1 'JetBrains Mono', monospace; letter-spacing: .1em; }
  @media (max-width: 780px) {
    .notes-head { grid-template-columns: 1fr; }
    .notes-head .section-copy { justify-self: start; }
    article { grid-template-columns: 2rem 1fr; padding-block: 1rem; }
    .note-state { grid-column: 2; width: max-content; }
  }
</style>
