---
import { useTranslations } from '../i18n/ui';

const t = useTranslations(Astro.currentLocale).logs;

const logs = [
  {
    date: '2025-08-14',
    type: 'INCIDENT',
    event: 'Production infrastructure issue on a Linux / nginx stack',
    resolution: 'Diagnosed root cause, restored service, hardened the affected layer',
    lesson: 'Reliability is a response process, not luck',
    status: 'FIXED',
  },
  {
    date: '2025-05-20',
    type: 'IMPLEMENTATION',
    event: 'Built RAG retrieval pipeline for semantic job matching',
    resolution: 'Embedding generation → vector search → AI re-ranking, deployed to production',
    lesson: 'Retrieval quality is decided by data shaping before model choice',
    status: 'DEPLOYED',
  },
  {
    date: '2025',
    type: 'DECISION',
    event: 'Chose asynchronous job processing for AI media generation',
    resolution: 'Durable job state in PostgreSQL instead of long-lived synchronous requests',
    lesson: 'Durable state beats optimistic connections',
    status: 'SHIPPED',
  },
  {
    date: '2024',
    type: 'IMPLEMENTATION',
    event: 'Scaled national testing services for exam-window peaks',
    resolution: 'Load-tested before windows; capacity added horizontally',
    lesson: 'Capacity is proven by rehearsal, not assumption',
    status: 'STABLE',
  },
  {
    date: '2024',
    type: 'DECISION',
    event: 'Kept exam writes retry-safe under double-clicks and network retries',
    resolution: 'Retry-safe answer persistence on the write path',
    lesson: 'Correctness under chaos is an API property',
    status: 'DEPLOYED',
  },
];
---

<section class="section-shell logs" id="logs" aria-labelledby="logs-title">
  <div class="logs-head"><div><p class="eyebrow">{t.eyebrow}</p><h2 class="section-title" id="logs-title">{t.title}</h2></div><div class="log-status"><i></i><span>{logs.length} {t.indexed}</span></div></div>
  <div class="log-window">
    <header><span>~/engineering/logs</span><code>tail -f production.log</code></header>
    <div class="log-rows">
      {logs.map((log, index) => (
        <article>
          <span class="number">{String(index + 1).padStart(2,'0')}</span>
          <div class="log-when"><time>{log.date}</time><em class:list={[log.type.toLowerCase()]}>{log.type}</em></div>
          <div class="log-what"><p>{log.event}</p><span>{log.resolution}</span></div>
          <code>→ {log.lesson}</code>
          <b>{log.status}</b>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .logs-head { display: flex; align-items: end; justify-content: space-between; gap: 2rem; }
  .log-status { display: flex; align-items: center; gap: .6rem; color: #52525b; font: 500 .57rem/1 'JetBrains Mono',monospace; }
  .log-status i { width: .4rem; height: .4rem; border-radius: 50%; background: #00ff88; }
  .log-window { margin-top: 4rem; border: 1px solid var(--line); border-radius: .45rem; background: rgba(255,255,255,.018); }
  .log-window > header { display: flex; align-items: center; justify-content: space-between; padding: 1rem 1.2rem; border-bottom: 1px solid var(--line); color: #71717a; font: 400 .6rem/1 'JetBrains Mono',monospace; }
  .log-window > header code { color: #3f3f46; font: inherit; }
  .log-rows article { display: grid; grid-template-columns: 2.5rem 8.5rem 1.5fr 1fr auto; align-items: center; gap: 1.25rem; min-height: 6rem; padding: 1rem 1.2rem; border-bottom: 1px solid var(--line); }
  .log-rows article:last-child { border-bottom: 0; }
  .number { color: #3f3f46; font: 400 .58rem/1 'JetBrains Mono',monospace; }
  .log-when { display: flex; flex-direction: column; gap: .5rem; align-items: flex-start; }
  time { color: #a1a1aa; font: 400 .63rem/1 'JetBrains Mono',monospace; }
  .log-when em { border: 1px solid var(--line-strong); border-radius: 99px; padding: .32rem .5rem; font: 500 .5rem/1 'JetBrains Mono',monospace; font-style: normal; letter-spacing: .08em; color: #a1a1aa; }
  .log-when em.incident { border-color: rgba(248,113,113,.3); color: #fca5a5; }
  .log-when em.implementation { border-color: rgba(0,255,136,.2); color: #00ff88; }
  .log-when em.decision { border-color: rgba(99,102,241,.35); color: #818cf8; }
  .log-what p { margin: 0; color: #e4e4e7; font-size: .85rem; line-height: 1.45; }
  .log-what span { display: block; margin-top: .4rem; color: #71717a; font-size: .72rem; line-height: 1.5; }
  article > code { color: #52525b; font: 400 .62rem/1.5 'JetBrains Mono',monospace; }
  article > b { min-width: 4.8rem; border: 1px solid rgba(0,255,136,.17); border-radius: 99px; padding: .42rem .55rem; color: #00ff88; font: 500 .5rem/1 'JetBrains Mono',monospace; text-align: center; }
  @media(max-width:900px){.log-rows article{grid-template-columns:2.5rem 8.5rem 1fr auto}.log-rows article>code{display:none}}
  @media(max-width:580px){.logs-head{display:block}.log-status{margin-top:1.5rem}.log-window>header code{display:none}.log-rows article{grid-template-columns:2rem 1fr auto;gap:.6rem}.log-when{grid-column:2}.log-what{grid-column:2;grid-row:2}.log-rows article b{grid-column:3;grid-row:1/3}.number{grid-row:1/3}}
</style>
