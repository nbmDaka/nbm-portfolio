---
import { useTranslations, localePrefix, localizedPath, type Locale } from '../i18n/ui';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const t = useTranslations(locale);
const home = localePrefix(locale);
const path = Astro.url.pathname;
const otherLocalePath = localizedPath(path, locale === 'ru' ? 'en' : 'ru');
---

<header class="nav-wrap">
  <nav class="nav page-shell" aria-label="Primary navigation">
    <a class="brand" href={`${home}/`} aria-label={t.nav.homeLabel}>
      <span class="brand-mark">NB</span>
      <span class="brand-name">NURDAULET.DEV</span>
    </a>
    <div class="nav-links">
      <a href={`${home}/#profile`}>{t.nav.profile}</a>
      <a href={`${home}/#experience`}>{t.nav.experience}</a>
      <a class:list={[{ active: path.includes('/projects') }]} href={`${home}/#projects`}>{t.nav.systems}</a>
      <a class:list={[{ active: path.endsWith('/stack') || path.endsWith('/stack/') }]} href={`${home}/stack`}>{t.nav.stack}</a>
      <a class="resume-link" href="/resume.pdf" download>{t.nav.resume}</a>
    </div>
    <div class="nav-actions">
      <a class="lang-switch" href={otherLocalePath} aria-label="Switch language / Сменить язык">
        <span class:list={[{ on: locale === 'en' }]}>EN</span><i>/</i><span class:list={[{ on: locale === 'ru' }]}>RU</span>
      </a>
      <button class="command-key" type="button" data-open-command aria-label={t.nav.paletteLabel}>
        <span>⌘</span><span>K</span>
      </button>
    </div>
  </nav>
</header>

<style>
  .nav-wrap {
    position: fixed;
    z-index: 50;
    inset: 0 0 auto;
    border-bottom: 1px solid rgba(255,255,255,0.075);
    background: rgba(5,5,5,0.78);
    backdrop-filter: blur(18px);
  }
  .nav {
    display: flex;
    height: 4.25rem;
    align-items: center;
    justify-content: space-between;
  }
  .brand { display: flex; align-items: center; gap: 0.75rem; color: white; text-decoration: none; }
  .brand-mark {
    display: grid; width: 1.75rem; height: 1.75rem; place-items: center;
    border: 1px solid rgba(0,255,136,0.55); border-radius: 0.25rem;
    color: #00ff88; font: 500 0.58rem/1 'JetBrains Mono', monospace;
  }
  .brand-name { font: 500 0.7rem/1 'JetBrains Mono', monospace; letter-spacing: 0.08em; }
  .nav-links { display: flex; align-items: center; gap: clamp(1.25rem, 3vw, 2.5rem); }
  .nav-links a { color: #71717a; font-size: 0.76rem; text-decoration: none; transition: color 160ms ease; }
  .nav-links a:hover, .nav-links a.active { color: white; }
  .resume-link { border-left: 1px solid rgba(255,255,255,0.14); padding-left: clamp(1.25rem, 3vw, 2.5rem); color: #00ff88 !important; }
  .resume-link:hover { text-decoration: underline; text-underline-offset: 4px; }
  .nav-actions { display: flex; align-items: center; gap: 0.75rem; }
  .lang-switch { display: flex; align-items: center; gap: 0.35rem; color: #52525b; font: 500 0.62rem/1 'JetBrains Mono', monospace; text-decoration: none; }
  .lang-switch span.on { color: #fff; }
  .lang-switch:hover span:not(.on) { color: #a1a1aa; }
  .lang-switch i { font-style: normal; color: #3f3f46; }
  .command-key {
    display: flex; gap: 0.3rem; align-items: center; min-width: 3.2rem; justify-content: center;
    border: 1px solid rgba(255,255,255,0.12); border-radius: 0.3rem;
    background: rgba(255,255,255,0.035); padding: 0.45rem 0.6rem; color: #a1a1aa;
    font: 500 0.66rem/1 'JetBrains Mono', monospace; cursor: pointer;
  }
  @media (max-width: 720px) {
    .nav-links { display: none; }
    .brand-name { font-size: 0.64rem; }
  }
</style>
