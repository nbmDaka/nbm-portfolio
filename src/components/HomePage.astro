---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from './Hero.astro';
import ImpactMetrics from './ImpactMetrics.astro';
import Profile from './Profile.astro';
import ExperienceTimeline from './react/ExperienceTimeline';
import Projects from './Projects.astro';
import ProjectEvidence from './ProjectEvidence.astro';
import ArchitectureLab from './ArchitectureLab.astro';
import EngineeringLogs from './EngineeringLogs.astro';
import EngineeringPrinciples from './EngineeringPrinciples.astro';
import EngineeringNotes from './EngineeringNotes.astro';
import Contact from './Contact.astro';
import { useTranslations } from '../i18n/ui';

const t = useTranslations(Astro.currentLocale);
---

<BaseLayout>
  <Hero />
  <ImpactMetrics />
  <Profile />
  <section class="section-shell experience" id="experience" aria-labelledby="experience-title">
    <div class="experience-head">
      <div><p class="eyebrow">{t.experience.eyebrow}</p><h2 class="section-title" id="experience-title">{t.experience.title}</h2></div>
      <p class="section-copy">{t.experience.copy}</p>
    </div>
    <ExperienceTimeline client:visible entries={t.experience.entries} labels={{ owned: t.experience.ownedLabel, contributed: t.experience.contributedLabel }} />
    <div class="education">
      <span class="mono-label">{t.experience.educationLabel}</span>
      <div class="education-main">
        <strong>{t.experience.education.school}</strong>
        <p>{t.experience.education.degree}</p>
      </div>
      <span class="education-period">{t.experience.education.period}</span>
    </div>
  </section>
  <Projects />
  <ProjectEvidence />
  <ArchitectureLab />
  <EngineeringLogs />
  <EngineeringPrinciples />
  <EngineeringNotes />
  <Contact />
</BaseLayout>

<style>
  .experience-head { display: grid; grid-template-columns: 1.1fr .9fr; align-items: end; gap: 5vw; }
  .experience-head .section-copy { justify-self: end; }
  .education { display: grid; grid-template-columns: 7rem 1fr auto; align-items: center; gap: clamp(1.5rem, 5vw, 5rem); padding: 1.6rem 0 0; border-top: 1px solid var(--line); }
  .education .mono-label { color: #52525b; }
  .education-main strong { font: 500 1rem/1.3 'Geist Variable', sans-serif; letter-spacing: -.01em; }
  .education-main p { margin: .35rem 0 0; color: #71717a; font-size: .82rem; }
  .education-period { color: #a1a1aa; font: 500 .66rem/1 'JetBrains Mono', monospace; }
  @media(max-width:780px){.experience-head{grid-template-columns:1fr}.experience-head .section-copy{justify-self:start}.education{grid-template-columns:1fr;gap:.5rem;align-items:start}}
</style>
