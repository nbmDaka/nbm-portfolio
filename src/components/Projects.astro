---
const projects = [
  { num: 'SYS_001', title: 'National Testing Platform', subtitle: 'High-concurrency public infrastructure', href: '/projects/national-testing-platform', stat: '3.5M+', unit: 'registered users', stack: ['Java', 'Spring Boot', 'PostgreSQL', 'React'], nodes: ['EDGE','API','CORE','DATA'], accent: 'green' },
  { num: 'SYS_002', title: 'AI Job Search Platform', subtitle: 'Semantic retrieval and recommendations', href: '/projects/ai-job-search', stat: 'RAG', unit: 'retrieval pipeline', stack: ['Embeddings', 'Vector DB', 'AI APIs'], nodes: ['QUERY','EMBED','VECTOR','AI'], accent: 'indigo' },
  { num: 'SYS_003', title: 'AI Media Generation', subtitle: 'Asynchronous generation workflows', href: '/projects/ai-media-generation', stat: 'ASYNC', unit: 'generation engine', stack: ['Next.js', 'PostgreSQL', 'AI APIs'], nodes: ['UI','JOBS','MODEL','STORE'], accent: 'white' },
];
---

<section class="section-shell projects" id="projects" aria-labelledby="projects-title">
  <div class="projects-head">
    <div><p class="eyebrow">03 / Production systems</p><h2 class="section-title" id="projects-title">Selected deployments.</h2></div>
    <p class="section-copy">Three systems, viewed through constraints, architecture, and measurable operational outcomes.</p>
  </div>
  <div class="project-list">
    {projects.map((project) => (
      <a class:list={['project', project.accent]} href={project.href}>
        <div class="project-id"><span>{project.num}</span><i>CASE STUDY</i></div>
        <div class="project-main"><p>{project.subtitle}</p><h3>{project.title}</h3><ul>{project.stack.map((item) => <li>{item}</li>)}</ul></div>
        <div class="mini-architecture" aria-hidden="true">
          {project.nodes.map((node, index) => <><span>{node}</span>{index < project.nodes.length - 1 && <i></i>}</>)}
        </div>
        <div class="project-stat"><strong>{project.stat}</strong><span>{project.unit}</span></div>
        <div class="open">OPEN SYSTEM <b>↗</b></div>
      </a>
    ))}
  </div>
</section>

<style>
  .projects-head { display: grid; grid-template-columns: 1.1fr .9fr; gap: 4vw; align-items: end; }
  .projects-head .section-copy { justify-self: end; }
  .project-list { margin-top: clamp(4rem,7vw,6rem); border-top: 1px solid var(--line-strong); }
  .project { display: grid; grid-template-columns: .65fr 1.8fr 1.4fr .75fr auto; align-items: stretch; min-height: 16rem; border-bottom: 1px solid var(--line); color: white; text-decoration: none; transition: background 200ms ease; }
  .project:hover { background: rgba(255,255,255,.028); }
  .project > div { padding: 1.4rem; border-right: 1px solid var(--line); }
  .project-id { display: flex; flex-direction: column; justify-content: space-between; color: #71717a; font: 500 .58rem/1 'JetBrains Mono', monospace; letter-spacing: .1em; }
  .project-id i { color: #3f3f46; font-style: normal; }
  .project-main { display: flex; flex-direction: column; justify-content: center; }
  .project-main > p { margin: 0 0 .85rem; color: #71717a; font: 400 .64rem/1.3 'JetBrains Mono', monospace; }
  .project-main h3 { margin: 0; font: 510 clamp(1.6rem,3vw,2.8rem)/1 'Geist Variable', sans-serif; letter-spacing: -.045em; }
  .project-main ul { display: flex; flex-wrap: wrap; gap: .5rem 1rem; margin: 1.7rem 0 0; padding: 0; list-style: none; }
  .project-main li { color: #52525b; font: 400 .58rem/1 'JetBrains Mono', monospace; }
  .mini-architecture { display: flex; align-items: center; justify-content: center; }
  .mini-architecture span { display: grid; width: 2.8rem; height: 2.8rem; place-items: center; border: 1px solid #3f3f46; border-radius: 50%; color: #71717a; font: 500 .43rem/1 'JetBrains Mono', monospace; }
  .mini-architecture i { width: min(2.2vw,2.4rem); height: 1px; background: #3f3f46; }
  .green:hover .mini-architecture span:nth-of-type(2), .green .project-stat strong { border-color: #00ff88; color: #00ff88; }
  .indigo:hover .mini-architecture span:nth-of-type(4), .indigo .project-stat strong { border-color: #6366f1; color: #818cf8; }
  .project-stat { display: flex; flex-direction: column; justify-content: center; gap: .5rem; }
  .project-stat strong { font: 500 clamp(1.8rem,3vw,3rem)/1 'Geist Variable', sans-serif; letter-spacing: -.04em; }
  .project-stat span { color: #52525b; font: 400 .56rem/1.3 'JetBrains Mono', monospace; }
  .open { display: flex; width: 5rem; flex-direction: column; justify-content: space-between; border-right: 0 !important; color: #52525b; font: 500 .5rem/1.2 'JetBrains Mono', monospace; writing-mode: vertical-rl; }
  .open b { color: #71717a; font-size: 1rem; font-weight: 400; }
  @media(max-width:980px){.project{grid-template-columns:.5fr 1.6fr 1fr auto}.mini-architecture{display:none}.projects-head{grid-template-columns:1fr}.projects-head .section-copy{justify-self:start}}
  @media(max-width:650px){.project{grid-template-columns:1fr auto;min-height:auto}.project-id{grid-column:1/-1;min-height:3.2rem;flex-direction:row;border-right:0!important}.project-main{min-height:12rem}.project-stat{grid-column:1;grid-row:3;min-height:7rem;border-top:1px solid var(--line)}.open{grid-column:2;grid-row:2/4}.project-main ul{gap:.5rem}.project-main h3{font-size:1.8rem}}
</style>
